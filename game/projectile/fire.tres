[resource]
code = "shader_type canvas_item;
render_mode blend_mix, unshaded;

uniform sampler2D Dissolver_texture : source_color, repeat_enable;
uniform sampler2D tex_frg_3 : source_color;
uniform sampler2D flame_texture : source_color;



void fragment() {
// Input:5
	vec4 n_out5p0 = COLOR;
	float n_out5p4 = n_out5p0.a;


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, UV);
	float n_out3p1 = n_out3p0.r;


// SmoothStep:4
	float n_in4p1 = 1.00000;
	float n_out4p0 = smoothstep(n_out5p4, n_in4p1, n_out3p1);


	vec4 n_out8p0;
// Texture2D:8
	n_out8p0 = texture(flame_texture, UV);
	float n_out8p1 = n_out8p0.r;


// FloatOp:6
	float n_out6p0 = n_out4p0 * n_out8p1;


// Output:0
	COLOR.rgb = vec3(n_out5p0.xyz);
	COLOR.a = n_out6p0;


}
"
